---
import BaseLayout from "../../layout/BaseLayout.astro";

const offerings = [
  {
    href: "/offerings/customer-onboarding",
    eyebrow: "Process Audit → Insight Engine",
    title: "AI-Powered Customer Onboarding",
    summary:
      "New client setup shouldn't depend on who remembers what. Formalize the workflow, automate document extraction, and build systems where every step triggers the next.",
    level: "L1 → L3",
  },
  {
    href: "/offerings/executive-reporting",
    eyebrow: "Insight Engine",
    title: "AI-Powered Executive Reporting",
    summary:
      "Leadership shouldn't wait for slides. Let executives self-serve insights from connected data sources — real answers in seconds, not reformatted dashboards.",
    level: "L2 → L3",
  },
  {
    href: "/offerings/hiring-pipeline",
    eyebrow: "Process Audit & Formalization",
    title: "AI-Powered Hiring Pipeline",
    summary:
      "Stop losing candidates to your own process. Formalize the tribal knowledge in hiring and keep candidates moving from intake to onboarded.",
    level: "L1 → L2",
  },
  {
    href: "/offerings/invoice-processing",
    eyebrow: "Process Audit → Insight Engine",
    title: "AI-Powered Invoice & AP Processing",
    summary:
      "Every invoice is different — your system should handle that. Parse any invoice format, match to POs, route approvals, and feed your GL with 94.5% validated accuracy.",
    level: "L1 → L3",
  },
  {
    href: "/offerings/monthly-close",
    eyebrow: "Process Audit & Formalization",
    title: "AI-Powered Monthly Close",
    summary:
      "Monthly close shouldn't take 10 days. Formalize the tribal knowledge in the close process and let AI reconcile, flag anomalies, and route approvals automatically.",
    level: "L1 → L2",
  },
];
---

<BaseLayout
  pageTitle="Offerings | TheFocus.AI"
  description="Concrete, principal-led AI engagements for mid-market and enterprise teams. Five offerings across process audit, formalization, and insight engines."
  category="capabilities"
  bigHeader
>
  <div class="max-w-4xl mx-auto">
    <section class="py-8 md:py-12">
      <p class="text-xs uppercase tracking-[0.15em] text-petrol font-medium mb-4">Offerings</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-ink leading-tight">
        From tribal knowledge to production AI
      </h1>
      <p class="text-xl md:text-2xl text-graphite leading-relaxed max-w-3xl">
        Five concrete engagements for mid-market and enterprise teams. Principal-led, scoped in weeks, shipped against a working process — not a 90-page deck.
      </p>
    </section>

    <section class="py-4 md:py-8">
      <ul class="grid gap-6 md:gap-8">
        {offerings.map((offering) => (
          <li>
            <a
              href={offering.href}
              class="block border border-ink/10 rounded-2xl p-6 md:p-8 hover:border-petrol/40 hover:shadow-lg hover:shadow-ink/5 transition-all duration-200"
            >
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-mono text-graphite border border-ink/15 px-2 py-1 rounded">{offering.level}</span>
                <span class="text-xs uppercase tracking-[0.15em] text-petrol font-medium">{offering.eyebrow}</span>
              </div>
              <h2 class="text-2xl md:text-3xl font-bold text-ink mb-3 leading-tight">
                {offering.title}
              </h2>
              <p class="text-base md:text-lg text-graphite leading-relaxed">
                {offering.summary}
              </p>
              <span class="inline-block mt-4 text-sm uppercase tracking-[0.15em] text-petrol font-medium">
                Read the offering →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="py-8 md:py-12 text-center">
      <p class="text-base md:text-lg text-graphite mb-6">
        Not sure which fits? A 60-minute <a href="/vibe-check" class="text-petrol underline underline-offset-2 hover:text-petrol/80">Vibe Check</a> will tell us — and tell you.
      </p>
      <a
        href="mailto:hey@thefocus.ai?subject=Offerings%20-%20Talk%20to%20a%20principal"
        class="inline-block px-8 py-4 bg-petrol text-paper font-medium uppercase text-sm tracking-wider rounded-full hover:bg-petrol/90 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
      >
        Talk to a principal →
      </a>
    </section>
  </div>
</BaseLayout>
