---
import BaseLayout from "../layouts/BaseLayout.astro";
import PracticeNav from "../components/PracticeNav.astro";
---

<BaseLayout title="Intelligent Organization — Habitats by TheFocus.AI" description="Habitats gives people and AI agents persistent shared rooms where conversations, runs, artifacts, and decisions become organizational memory." current="organization" newsletter={false}>
  <main>
    <section class="gtm-section ledger-grid min-h-[760px] flex items-center"><div class="gtm-shell grid lg:grid-cols-12 gap-12 items-center"><div class="lg:col-span-7"><div class="gtm-kicker mb-6">Intelligent Organization · Habitats</div><h1 class="max-w-[11ch] text-5xl sm:text-7xl lg:text-8xl leading-[0.9] font-semibold tracking-[-0.065em]">Your team and its agents, working in one shared place.</h1><p class="gtm-lede mt-8"><strong class="text-white">Habitats gives people and AI agents persistent rooms.</strong> Conversations, runs, artifacts, and decisions stay together—turning private AI practice into shared organizational memory.</p><div class="flex flex-col sm:flex-row gap-3 mt-8"><a class="gtm-button gtm-button-primary" href="mailto:wschenk@thefocus.ai?subject=Intelligent%20Organization%20project">See Habitats with your team</a><a class="gtm-button" href="#cooperation">See how the room works</a></div></div><aside class="lg:col-span-5 border border-white/20 bg-[#111111]" aria-label="Illustration of a shared Habitat room"><div class="flex justify-between p-4 border-b border-white/10 gtm-kicker"><span># launch-brief</span><span class="text-[#9db565]">● live room</span></div><div class="p-5">{[["AM","Ana · Product","What changed in the research since Tuesday? @Research Agent, synthesize it against our launch brief."],["RA","Research Agent","I’m reading this room’s brief, linked interviews, and the team’s decision from Tuesday."],["MK","Malik · Strategy","Keep finding 3. That changes the launch sequence. I’ve added the decision below."]].map(([initials,name,copy], index) => <div class="grid grid-cols-[2rem_1fr] gap-3 py-4 border-b border-white/10 text-xs"><div class:list={["w-7 h-7 grid place-items-center mono text-[9px]", index === 1 ? "bg-[#556B2F]" : "border border-white/20"]}>{initials}</div><div><b class="block mb-1">{name}</b><span class="text-[#999]">{copy}</span>{index === 1 && <div class="mt-3 p-3 border-l-2 border-[#556B2F] bg-[#0A0A0A] mono text-[9px] space-y-1"><div class="flex justify-between"><span>REQUEST</span><strong>ROOM-028</strong></div><div class="flex justify-between"><span>STEPS</span><strong>4 recorded</strong></div><div class="mt-2 p-2 bg-[#556B2F]/20">▰ Artifact · Research delta.md</div></div>}</div></div>)}</div><div class="p-4 border-t border-white/10 text-xs text-[#999]">Message the room or @mention an attached agent…</div></aside></div></section>

    <section class="gtm-section bg-[#556B2F]/15"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-10"><div class="lg:col-span-5"><div class="gtm-kicker mb-3">The organizational gap</div><h2 class="gtm-heading">The work is happening. The learning is not.</h2></div><p class="lg:col-span-7 text-xl sm:text-2xl leading-relaxed text-[#B0B0B0]">Useful prompts sit in personal chat histories. Agent runs disappear into separate tools. Decisions lose their context. <strong class="text-white">Habitats makes AI-assisted work visible to the team that needs to build on it.</strong></p></div><div class="grid grid-cols-2 lg:grid-cols-4 mt-12 border-l border-t border-white/20">{[["01 / Today","Private chats"],["02 / Today","Detached outputs"],["03 / Shared room","Visible practice"],["04 / Over time","Reusable memory"]].map(([n,title]) => <div class="p-5 min-h-36 border-r border-b border-white/20"><b class="gtm-kicker">{n}</b><span class="block text-xl mt-10">{title}</span></div>)}</div></div></section>

    <section class="gtm-section" id="cooperation"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">Intelligent Cooperation · the enabling practice</div><h2 class="gtm-heading">Stay in conversation while agents do the work.</h2></div><p class="gtm-lede lg:col-span-4">Not an autonomous agent-to-agent organization. A shared cooperation model where people direct, inspect, discuss, and reuse agent work together.</p></div><div class="grid lg:grid-cols-[15rem_1fr] mt-12 border border-white/10"><div class="grid grid-cols-2 lg:block border-b lg:border-b-0 lg:border-r border-white/10" role="tablist" aria-label="Cooperation sequence">{["01 / Post","02 / Read","03 / Return","04 / Build on"].map((label,index) => <button class:list={["timeline-tab w-full p-5 text-left mono text-[10px] uppercase border-r border-b border-white/10 last:border-b-0", index === 0 && "is-active"]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"}>{label}</button>)}</div><div class="p-6 sm:p-10 min-h-[420px]" aria-live="polite"><div id="stage-count" class="gtm-kicker">Step 01 · Human → Room</div><h3 id="stage-title" class="max-w-xl text-3xl sm:text-5xl leading-tight font-semibold tracking-tight mt-12">A person posts in the flow of work.</h3><p id="stage-copy" class="gtm-lede mt-5">A teammate asks a question, shares an artifact, or records a decision—and @mentions an agent attached to that room.</p><div class="grid grid-cols-3 sm:grid-cols-6 mt-10 border-l border-t border-white/10">{["Human","Room","Agent","Run","Result","Memory"].map((node,index) => <div class:list={["route-node p-3 border-r border-b border-white/10 mono text-[8px] uppercase", index < 2 && "is-on"]}>{node}</div>)}</div></div></div></div></section>

    <section class="gtm-section bg-[#111111]"><div class="gtm-shell grid lg:grid-cols-12 gap-12"><div class="lg:col-span-5"><div class="gtm-kicker mb-3">Connected provenance</div><h2 class="gtm-heading">See the path, not just the answer.</h2><p class="gtm-lede mt-6">The foundation connects a request to its run, steps, result, artifact, and cost—so teams can inspect how work unfolded.</p></div><div class="lg:col-span-7 border-t border-white/10">{[["Request","Compare findings with launch brief","Human"],["Run","Research agent / room context","System"],["Steps","Sources read · analysis performed","Recorded"],["Result","Finding posted back to room","Agent"],["Artifact","Research delta.md","Persisted"],["Cost","Usage connected to run","Tracked"]].map(([key,value,status]) => <div class="grid grid-cols-[5rem_1fr] sm:grid-cols-[5rem_1fr_6rem] gap-3 py-4 border-b border-white/10"><b class="gtm-kicker">{key}</b><span>{value}</span><small class="col-start-2 sm:col-start-auto text-[#999] mono text-[9px] uppercase sm:text-right">{status}</small></div>)}<div class="p-4 mt-6 border border-white/20 text-xs text-[#888]"><strong class="text-white">Foundation implemented.</strong> This is not a claim of perfect, immutable, or comprehensive audit coverage. The next level of controls should be designed around your risk and governance requirements.</div></div></div></section>

    <section class="gtm-section"><div class="gtm-shell grid lg:grid-cols-12 gap-12"><div class="lg:col-span-6"><div class="gtm-kicker mb-3">Control & deployment</div><h2 class="gtm-heading">Start hosted. Design the right boundary.</h2><p class="gtm-lede mt-6">Habitats is hosted today and can route work to managed models or remote agents. Architecture choices should follow sensitivity, volume, and economics—not infrastructure theatre.</p></div><div class="lg:col-span-6 border-t border-white/10">{[["01","Hosted Habitats","Today","A working shared-room product for people, agents, and artifacts."],["02","Managed models or remote agents","Route","Connect the room to the execution approach appropriate for the work."],["03","Private cloud / on-prem GPU compute","Evaluate","Options to evaluate when sensitivity, sustained volume, and economics justify them—not currently packaged proof."]].map(([n,title,status,copy]) => <div class="grid grid-cols-[2.5rem_1fr] gap-4 py-5 border-b border-white/10"><i class="not-italic gtm-kicker">{n}</i><div><h3 class="font-semibold">{title} <em class="not-italic ml-2 px-2 py-1 bg-[#556B2F]/25 mono text-[8px] uppercase">{status}</em></h3><p class="text-sm text-[#888] mt-2">{copy}</p></div></div>)}</div></div></section>

    <section class="gtm-section bg-[#0d0d0d]" id="proof"><div class="gtm-shell"><div class="gtm-kicker mb-3">Product proof · working thesis / demo</div><h2 class="gtm-heading">Concrete enough to put in front of a team.</h2><div class="grid md:grid-cols-3 mt-12 border-l border-t border-white/10">{[["Room","A working multi-user room with live updates and real agent responses."],["Context","Shared room context that a person and attached agent can both build from."],["Memory","A persisted document artifact and organization-scoped data."]].map(([title,copy]) => <div class="p-6 min-h-52 border-r border-b border-white/10"><b class="gtm-kicker">{title}</b><p class="text-xl mt-12">{copy}</p></div>)}</div><p class="max-w-3xl mt-7 text-sm text-[#999]">This is product evidence, not an established customer outcome. Habitats is a working thesis and demo ready to test with one team, one room, and one consequential workflow.</p></div></section>

    <section class="gtm-section" id="reading"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">External reading · TheFocus.AI Labs</div><h2 class="gtm-heading">The thinking behind the room.</h2></div><p class="gtm-lede lg:col-span-4">Three field notes on organizational maturity, cooperation, and why agent work needs a habitat.</p></div><div class="grid md:grid-cols-3 mt-12 border-l border-t border-white/10">{[["01 / Maturity","Laddering Up from Chatboxes to Autonomy","https://labs.thefocus.ai/dispatch/laddering-up-from-chatboxes-to-autonomy/"],["02 / Organization","Building an Intelligent Organization","https://labs.thefocus.ai/dispatch/building-an-intelligent-organization/"],["03 / Habitat","The Agent Habitat","https://labs.thefocus.ai/dispatch/agent-habitat/"]].map(([type,title,href]) => <a class="p-6 min-h-56 border-r border-b border-white/10 flex flex-col hover:bg-[#556B2F]/10" href={href} target="_blank" rel="noopener noreferrer"><b class="gtm-kicker">{type}</b><h3 class="text-2xl font-semibold mt-auto">{title}</h3><span class="gtm-kicker mt-5">Read on Labs ↗</span></a>)}</div></div></section>
    <PracticeNav current="organization" />
    <section class="gtm-section text-center bg-[#556B2F]/10"><div class="gtm-shell"><div class="gtm-kicker">Start with one team · one room · one workflow</div><h2 class="gtm-heading mx-auto mt-4">Make your team’s AI practice shared.</h2><p class="gtm-lede mx-auto mt-6">Bring a real workflow. We’ll show how its conversation, agent work, artifacts, and decisions can live together.</p><a class="gtm-button gtm-button-primary mt-8" href="mailto:wschenk@thefocus.ai?subject=Intelligent%20Organization%20project">See Habitats with your team</a></div></section>
  </main>
</BaseLayout>

<style>.timeline-tab.is-active { background: rgb(85 107 47 / .28); color: white; }.route-node.is-on { background: rgb(85 107 47 / .28); color: white; }</style>
<script>
  const steps = [
    { count: "STEP 01 · HUMAN → ROOM", title: "A person posts in the flow of work.", copy: "A teammate asks a question, shares an artifact, or records a decision—and @mentions an agent attached to that room.", on: 2 },
    { count: "STEP 02 · ROOM → AGENT", title: "The agent reads the shared room context.", copy: "The attached agent receives the request with the relevant conversation and room materials, rather than beginning from an isolated blank chat.", on: 3 },
    { count: "STEP 03 · AGENT → ROOM", title: "The run and result come back to the team.", copy: "The agent performs the work and posts its result into the same conversation, with a connected run and artifact the team can inspect.", on: 5 },
    { count: "STEP 04 · MEMORY → NEXT WORK", title: "Later work can build on the result.", copy: "A teammate—or an agent they direct later—can find the discussion, result, artifact, and decision while the team stays in conversation.", on: 6 },
  ];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".timeline-tab")]; const nodes = [...document.querySelectorAll<HTMLElement>(".route-node")]; const count = document.querySelector<HTMLElement>("#stage-count"); const title = document.querySelector<HTMLElement>("#stage-title"); const copy = document.querySelector<HTMLElement>("#stage-copy");
  function showStep(index: number) { const step = steps[index]; if (!step || !count || !title || !copy) return; count.textContent = step.count; title.textContent = step.title; copy.textContent = step.copy; tabs.forEach((tab,i) => { const active = i === index; tab.classList.toggle("is-active", active); tab.setAttribute("aria-selected", String(active)); tab.tabIndex = active ? 0 : -1; }); nodes.forEach((node,i) => node.classList.toggle("is-on", i < step.on)); }
  tabs.forEach((tab,index) => { tab.tabIndex = index === 0 ? 0 : -1; tab.addEventListener("click", () => showStep(index)); tab.addEventListener("keydown", (event) => { if (!["ArrowRight","ArrowDown","ArrowLeft","ArrowUp","Home","End"].includes(event.key)) return; event.preventDefault(); const forward = event.key === "ArrowRight" || event.key === "ArrowDown"; const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (forward ? 1 : -1) + tabs.length) % tabs.length; showStep(next); tabs[next]?.focus(); }); });
</script>
