---
import BaseLayout from "../../layout/BaseLayout.astro";

const pdfPath = "/lead-magnet/production-ai-readiness.pdf";
const pdfUrl = new URL(pdfPath, Astro.site).href;
const pageTitle = "Your Production AI Readiness one-pager · TheFocus.AI";
const description =
  "The 12 questions we ask before any engagement. Download the Production AI Readiness one-pager from TheFocus.AI.";
---

<BaseLayout pageTitle={pageTitle} description={description} category="studio">
  <section class="max-w-2xl mx-auto py-12 md:py-20 px-5 md:px-8">
    <p class="text-xs uppercase tracking-[0.2em] text-petrol mb-3 font-medium">
      Your one-pager is ready
    </p>
    <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4" style="color: #161616;">
      Thanks for subscribing.
    </h1>
    <p class="text-base md:text-lg leading-relaxed mb-8" style="color: #4a4a4a;">
      Your copy of <strong>The Production AI Readiness one-pager</strong> — the 12 questions we
      ask before any engagement — is below. We also emailed it to you, so it lives in your inbox
      the next time you need it.
    </p>

    <div class="rounded-2xl p-6 md:p-8 mb-10" style="background-color: #faf9f6; border: 1px solid #e6e4dc;">
      <p class="text-sm uppercase tracking-wider mb-2" style="color: #4a4a4a;">PDF · Letter · 1 page</p>
      <h2 class="text-xl md:text-2xl font-bold mb-4" style="color: #161616;">
        Production AI Readiness — the 12 questions
      </h2>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          id="magnet-download"
          href={pdfPath}
          download
          data-magnet="production-ai-readiness"
          data-magnet-action="download"
          class="inline-flex items-center justify-center px-6 py-3 text-white font-medium uppercase text-sm tracking-wider rounded-full transition-all duration-200"
          style="background-color: #0e3b46;"
        >
          Download the PDF
        </a>
        <a
          href={pdfPath}
          target="_blank"
          rel="noopener"
          data-magnet="production-ai-readiness"
          data-magnet-action="open"
          class="inline-flex items-center justify-center px-6 py-3 font-medium uppercase text-sm tracking-wider rounded-full transition-all duration-200"
          style="border: 2px solid #e6e4dc; color: #0e3b46;"
        >
          Open in browser
        </a>
      </div>
      <p class="text-xs mt-4" style="color: #4a4a4a;">
        Trouble downloading? Use this link: <a href={pdfUrl} class="underline" style="color: #0e3b46;">{pdfUrl}</a>
      </p>
    </div>

    <h3 class="text-lg md:text-xl font-bold mb-2" style="color: #161616;">What happens next</h3>
    <ul class="text-base leading-relaxed space-y-2 list-disc pl-5 mb-10" style="color: #4a4a4a;">
      <li>Confirmation email from Buttondown — click it once so future essays land in your inbox.</li>
      <li>A welcome note with the one-pager link, in case you want it in email.</li>
      <li>One short essay per week. Reply to any of them — these go straight to a principal.</li>
    </ul>

    <div class="rounded-2xl p-6" style="background-color: #faf9f6; border: 1px solid #e6e4dc;">
      <h3 class="text-lg md:text-xl font-bold mb-2" style="color: #161616;">
        Want a second pair of eyes on the homework?
      </h3>
      <p class="text-base leading-relaxed mb-4" style="color: #4a4a4a;">
        If three or more of the 12 questions came back fuzzy when your team walked through them,
        that's a project — not a feature. We do that for a living.
      </p>
      <a
        href="/capabilities"
        class="inline-flex items-center px-5 py-2.5 text-white font-medium uppercase text-sm tracking-wider rounded-full transition-all duration-200"
        style="background-color: #0e3b46;"
      >
        See our framework
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Fire `lead_magnet_delivered` on page load — the user has the magnet (we just gave
  // them the link) regardless of whether they click download. `?signed_up=1` is appended
  // when this page is the post-subscribe redirect, so we can split "delivered via fresh
  // signup" from "delivered via direct visit / back-link from welcome email" in Plausible.
  type Plausible = (event: string, opts?: { props?: Record<string, string> }) => void;
  const w = window as unknown as { plausible?: Plausible };
  const magnet = "production-ai-readiness";
  try {
    const via = new URLSearchParams(location.search).get("signed_up") === "1" ? "signup" : "direct";
    w.plausible?.("lead_magnet_delivered", { props: { magnet, path: location.pathname, via } });
  } catch {}

  document.querySelectorAll<HTMLAnchorElement>("a[data-magnet]").forEach((a) => {
    a.addEventListener("click", () => {
      try {
        w.plausible?.("lead_magnet_action", {
          props: {
            magnet: a.dataset.magnet || "unknown",
            action: a.dataset.magnetAction || "download",
          },
        });
      } catch {}
    });
  });
</script>
