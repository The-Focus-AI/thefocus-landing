    z-index: 0;
  }
  .cs-glow--amber {
    width: 46vw;
    height: 46vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle, rgba(255, 176, 92, 0.3) 0%, rgba(255, 150, 70, 0.1) 45%, transparent 70%);
    top: -10%;
    right: -6%;
    animation: csDrift1 19s ease-in-out infinite;
  }
  .cs-glow--olive {
    width: 42vw;
    height: 42vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle, rgba(133, 156, 72, 0.3) 0%, rgba(85, 107, 47, 0.1) 45%, transparent 70%);
    bottom: 4%;
    left: -10%;
    animation: csDrift2 23s ease-in-out infinite;
  }
  @keyframes csDrift1 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translate3d(-4%, 5%, 0) scale(1.1);
      opacity: 0.78;
    }
  }
  @keyframes csDrift2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.45;
    }
    50% {
      transform: translate3d(6%, -4%, 0) scale(1.12);
      opacity: 0.72;
    }
  }

  /* Featured hero: a soft warmth that pools over the photo's own light
     trails and breathes very slowly — no moving streak. */
  .cs-feature-img {
    transform: scale(1);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-feature:hover .cs-feature-img {
    transform: scale(1.03);
  }
  .cs-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(70% 60% at 52% 72%, rgba(255, 196, 128, 0.14) 0%, rgba(255, 176, 96, 0.05) 45%, transparent 70%);
    opacity: 0.4;
    animation: csGlow 16s ease-in-out infinite;
  }
  @keyframes csGlow {
    0%,
    100% {
      opacity: 0.28;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Small grid cards: light bloom on hover */
  .cs-card-media {
    position: relative;
    overflow: hidden;
  }
  .cs-card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 85% at 50% 120%, rgba(255, 176, 92, 0.28), transparent 62%);
    opacity: 0;
    transition: opacity 0.5s ease;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .cs-card:hover .cs-card-media::after {
    opacity: 1;
  }
  .cs-card-media img {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-card:hover .cs-card-media img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-glow,
    .cs-sweep,
    .cs-feature-img,
    .cs-card-media img {
      animation: none;
      transition: none;
    }
  }

  /* Method: an operating rail, not three generic cards */
  .method-system {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(circle at 85% 0%, rgba(85, 107, 47, 0.15), transparent 32%),
      linear-gradient(180deg, #121212 0%, #0b0b0b 100%);
  }
  .method-system::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent 78%);
    pointer-events: none;
  }
  .method-rail {
    position: absolute;
    left: 2rem;
    right: 2rem;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, rgba(85, 107, 47, 0.05), rgba(85, 107, 47, 0.65), rgba(85, 107, 47, 0.05));
    transform: translateY(-50%);
  }
  .method-step {
    position: relative;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(10, 10, 10, 0.58);
    backdrop-filter: blur(10px);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.45s ease,
      border-color 0.45s ease;
  }
  .method-step:first-child {
    border-left: 0;
  }
  .method-step::before {
    content: "";
    position: absolute;
    top: 2rem;
    left: 2rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #556b2f;
    box-shadow: 0 0 0 8px rgba(85, 107, 47, 0.12);
  }
  .method-step::after {
    content: attr(data-num);
    position: absolute;
    right: 1.5rem;
    bottom: -1.15rem;
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: clamp(5.75rem, 12vw, 10rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.025);
    pointer-events: none;
    transition:
      color 0.45s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .method-step:hover {
    transform: translateY(-6px);
    background: rgba(17, 17, 13, 0.78);
    border-color: rgba(85, 107, 47, 0.35);
  }
  .method-step:hover::after {
    color: rgba(85, 107, 47, 0.1);
    transform: translateY(-8px);
  }
  .method-step-body {
    position: relative;
    z-index: 1;
    padding: 5.5rem 2rem 2rem;
    min-height: 21rem;
  }
  .method-step-build {
    background:
      radial-gradient(circle at 78% 18%, rgba(85, 107, 47, 0.16), transparent 34%),
      rgba(17, 17, 13, 0.7);
  }
  .method-side-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.18em;
  }
  .team-keeps {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(circle at 78% 12%, rgba(85, 107, 47, 0.12), transparent 28%),
      radial-gradient(circle at 18% 82%, rgba(168, 104, 48, 0.08), transparent 32%),
      linear-gradient(180deg, #0b0b0b 0%, #10100d 52%, #080808 100%);
  }

  .team-keeps::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    pointer-events: none;
  }

  .tk-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0e0e0c;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease;
  }

  .tk-card:hover {
    transform: translateY(-4px);
    border-color: rgba(85, 107, 47, 0.34);
  }

  .tk-shot {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #0b0d08;
  }

  .tk-shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Natural color with a light grade, matching the photos up top */
    filter: contrast(1.04) saturate(1.04) brightness(0.92);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tk-card:hover .tk-shot img {
    transform: scale(1.04);
  }

  .tk-shot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, rgba(85, 107, 47, 0.16), rgba(0, 0, 0, 0) 48%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .tk-shot::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 52%, rgba(10, 10, 10, 0.42));
    pointer-events: none;
  }

  .tk-tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 2;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(229, 229, 229, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(8px);
    padding: 0.3rem 0.5rem;
  }

  .tk-body {
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .team-keeps-ledger {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      linear-gradient(90deg, rgba(85, 107, 47, 0.1), transparent 34%),
      rgba(255, 255, 255, 0.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .method-step,
    .method-step::after,
    .tk-card,
    .tk-shot img {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .habitats-display {
      padding: 10px;
      border-radius: 14px;
    }

    .habitats-display::after {
      display: none;
    }

    .method-rail,
    .method-side-label {
      display: none;
    }
    .method-step {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .method-step:first-child {
      border-top: 0;
    }
    .method-step-body {
      min-height: auto;
      padding: 4.5rem 1.5rem 1.75rem;
    }
  }

  /* Hero "watch the film" button + film modal */
  .hero-play-btn {
    opacity: 0.4;
    cursor: pointer;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .hero-play-btn:hover,
  .hero-play-btn:focus-visible {
    opacity: 1;
    transform: scale(1.05);
    outline: none;
  }
  .hero-play-btn:focus-visible .hero-play-ring {
    border-color: rgba(157, 181, 101, 0.9);
  }
  .hero-film-modal {
    display: none;
  }
  .hero-film-modal.is-open {
    display: flex;
  }
</style>

<script>
  // Keep overlays pinned to features in the source photo, regardless of
  // object-cover cropping. Rects are fractions of the 1536×1024 image.
  const TRAIN_SOURCE_RECT = {
    x: 0.0,
    y: 0.36,
    width: 0.665,
    height: 0.105,
  };
  // Pendant at ~(0.862, 0.239). Box is sized so the radial-gradient
  // hotspot (50% 40%) sits on the fixture.
  const LAMP_SOURCE_RECT = {
    x: 0.777,
    y: 0.111,
    width: 0.17,
    height: 0.32,
  };

  type HeroCoverLayout = {
    stage: HTMLElement;
    img: HTMLImageElement;
    stageW: number;
    stageH: number;
    drawnW: number;
    drawnH: number;
    offsetX: number;
    offsetY: number;
  };

  function getHeroCoverLayout(): HeroCoverLayout | null {
    const stage = document.querySelector<HTMLElement>(".hero-stage");
    const img = document.querySelector<HTMLImageElement>(".hero-img");
    if (!stage || !img) return null;

    const stageW = stage.clientWidth;
    const stageH = stage.clientHeight;
    const naturalW = img.naturalWidth;
    const naturalH = img.naturalHeight;
    if (!stageW || !stageH || !naturalW || !naturalH) return null;

    const scale = Math.max(stageW / naturalW, stageH / naturalH);
    const drawnW = naturalW * scale;
    const drawnH = naturalH * scale;
    return {
      stage,
      img,
      stageW,
      stageH,
      drawnW,
      drawnH,
      offsetX: (stageW - drawnW) / 2,
      offsetY: (stageH - drawnH) / 2,
    };
  }

  function alignTrainOverlay(layout: HeroCoverLayout) {
    const trackArea = document.querySelector<HTMLElement>(".train-track-area");
    if (!trackArea) return;

    const { stageW, stageH, drawnW, drawnH, offsetX, offsetY } = layout;
    const left = offsetX + TRAIN_SOURCE_RECT.x * drawnW;
    const top = offsetY + TRAIN_SOURCE_RECT.y * drawnH;
    const right = left + TRAIN_SOURCE_RECT.width * drawnW;
    const bottom = top + TRAIN_SOURCE_RECT.height * drawnH;

    // Clamp the mapped rail band to the visible hero region.
    const visibleLeft = Math.max(0, left);
    const visibleTop = Math.max(0, top);
    const visibleRight = Math.min(stageW, right);
    const visibleBottom = Math.min(stageH, bottom);
    const visibleWidth = Math.max(0, visibleRight - visibleLeft);
    const visibleHeight = Math.max(0, visibleBottom - visibleTop);

    if (visibleWidth < 2 || visibleHeight < 2) {
      trackArea.classList.remove("is-ready", "is-settled");
      trackArea.style.width = "0px";
      trackArea.style.height = "0px";
      return;
    }

    trackArea.style.left = `${visibleLeft}px`;
    trackArea.style.top = `${visibleTop}px`;
    trackArea.style.width = `${visibleWidth}px`;
    trackArea.style.height = `${visibleHeight}px`;

    trackArea.querySelectorAll<HTMLElement>(".train-band-img").forEach((bandImg) => {
      bandImg.style.left = `${offsetX - visibleLeft}px`;
      bandImg.style.top = `${offsetY - visibleTop}px`;
      bandImg.style.width = `${drawnW}px`;
      bandImg.style.height = `${drawnH}px`;
    });

    trackArea.classList.add("is-ready", "is-settled");
  }

  function alignLampGlow(layout: HeroCoverLayout) {
    const lamp = document.querySelector<HTMLElement>(".lamp-glow");
    if (!lamp) return;

    const { stageW, stageH, drawnW, drawnH, offsetX, offsetY } = layout;
    const left = offsetX + LAMP_SOURCE_RECT.x * drawnW;
    const top = offsetY + LAMP_SOURCE_RECT.y * drawnH;
    const width = LAMP_SOURCE_RECT.width * drawnW;
    const height = LAMP_SOURCE_RECT.height * drawnH;

    lamp.style.left = `${left}px`;
    lamp.style.top = `${top}px`;
    lamp.style.width = `${width}px`;
    lamp.style.height = `${height}px`;

    const hotspotX = left + width * 0.5;
    const hotspotY = top + height * 0.4;
    const onscreen =
      hotspotX >= 0 && hotspotX <= stageW && hotspotY >= 0 && hotspotY <= stageH;
    lamp.classList.toggle("is-offscreen", !onscreen);
  }

  function alignHeroOverlays() {
    const layout = getHeroCoverLayout();
    if (!layout) return;
    alignTrainOverlay(layout);
    alignLampGlow(layout);
  }

  let heroAlignRaf: number | null = null;
  function scheduleHeroOverlayAlign() {
    if (heroAlignRaf) cancelAnimationFrame(heroAlignRaf);
    heroAlignRaf = requestAnimationFrame(() => {
      heroAlignRaf = null;
      alignHeroOverlays();
    });
  }

  const heroImg = document.querySelector<HTMLImageElement>(".hero-img");
  if (heroImg) {
    if (heroImg.complete) scheduleHeroOverlayAlign();
    heroImg.addEventListener("load", scheduleHeroOverlayAlign);
  }
  window.addEventListener("resize", scheduleHeroOverlayAlign);
  window.addEventListener("orientationchange", scheduleHeroOverlayAlign);
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(scheduleHeroOverlayAlign);
  }
  if ("ResizeObserver" in window) {
    const stage = document.querySelector(".hero-stage");
    if (stage) {
      const trackResizeObserver = new ResizeObserver(scheduleHeroOverlayAlign);
      trackResizeObserver.observe(stage);
    }
  }
  scheduleHeroOverlayAlign();

  // Habitats live preview slides
  const habitatsSlides = [
    {
      src: "/assets/habitats-marketplace.html",
      title: "Habitats agent marketplace live preview",
      note: "When your team works in the same space, the best AI results get shared — not trapped in one person's private chat.",
    },
    {
      src: "/assets/habitats-workstreams.html",
      title: "Habitats morning workstream live preview",
      note: "Learn how people across the company are getting better results from their agents, then bring those patterns back to your own work.",
    },
    {
      src: "/assets/habitats-gigalytics.html",
      title: "Habitats run history live preview",
      note: "Use existing agents or build your own for a specific workflow, then share them with your colleagues and company.",
    },
  ];

  const habitatsLiveStage = document.querySelector<HTMLElement>("#habitats-live-stage");
  const habitatsScreen = document.querySelector<HTMLElement>(".habitats-screen");
  const habitatsSlideFrame = document.querySelector<HTMLIFrameElement>("#habitats-slide-frame");
  const habitatsSlideNote = document.querySelector<HTMLElement>("#habitats-slide-note");
  const habitatsSlideControls = Array.from(document.querySelectorAll<HTMLButtonElement>(".habitats-slide-control"));
  const habitatsMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  // No autoplay on touch / small screens: the rotating note fights readers there.
  const habitatsNoAutoplayQuery = window.matchMedia("(hover: none), (max-width: 1023px)");
  let habitatsSlideIndex = 0;
  let habitatsSlideTimer: number | undefined;
  let habitatsAutoplayPaused = false;

  function fitHabitatsFrame() {
    if (!habitatsLiveStage || !habitatsScreen) return;
    const rect = habitatsScreen.getBoundingClientRect();
    const scale = Math.min(rect.width / 1480, rect.height / 900);
    habitatsLiveStage.style.setProperty("--habitats-frame-scale", scale.toFixed(4));
  }

  function setHabitatsSlide(index: number, options: { force?: boolean } = {}) {
    const slide = habitatsSlides[index];
    if (!slide || !habitatsLiveStage || !habitatsSlideFrame) return;
    if (!options.force && index === habitatsSlideIndex && habitatsSlideFrame.src.includes(slide.src)) return;
    habitatsSlideIndex = index;

    habitatsSlideControls.forEach((control, controlIndex) => {
      const isSelected = controlIndex === index;
      control.setAttribute("aria-checked", String(isSelected));
      control.setAttribute("tabindex", isSelected ? "0" : "-1");
    });

    if (habitatsSlideNote) {
      habitatsSlideNote.textContent = slide.note;
    }

    habitatsLiveStage.classList.add("is-changing");
    const clearChanging = window.setTimeout(() => habitatsLiveStage.classList.remove("is-changing"), 900);
    habitatsSlideFrame.addEventListener(
      "load",
      () => {
        window.clearTimeout(clearChanging);
        window.requestAnimationFrame(() => habitatsLiveStage.classList.remove("is-changing"));
      },
      { once: true }
    );
    habitatsSlideFrame.src = slide.src;
    habitatsSlideFrame.title = slide.title;
  }

  function stopHabitatsAutoplay() {
    window.clearInterval(habitatsSlideTimer);
    habitatsSlideTimer = undefined;
  }

  function startHabitatsAutoplay() {
    if (
      !habitatsSlideControls.length ||
      habitatsMotionQuery.matches ||
      habitatsNoAutoplayQuery.matches ||
      habitatsAutoplayPaused ||
      document.hidden
    )
      return;
    stopHabitatsAutoplay();
    habitatsSlideTimer = window.setInterval(() => {
      setHabitatsSlide((habitatsSlideIndex + 1) % habitatsSlides.length);
    }, 5200);
  }

  function pauseHabitatsAutoplay() {
    habitatsAutoplayPaused = true;
    stopHabitatsAutoplay();
  }

  function resumeHabitatsAutoplay() {
    habitatsAutoplayPaused = false;
    startHabitatsAutoplay();
  }

  habitatsSlideControls.forEach((control) => {
    control.addEventListener("click", () => {
      setHabitatsSlide(Number(control.dataset.habitatsSlide));
      startHabitatsAutoplay();
    });

    control.addEventListener("keydown", (event) => {
      const currentIndex = Number(control.dataset.habitatsSlide);
      const lastIndex = habitatsSlideControls.length - 1;
      let nextIndex = currentIndex;

      if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = currentIndex === lastIndex ? 0 : currentIndex + 1;
      if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = currentIndex === 0 ? lastIndex : currentIndex - 1;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = lastIndex;
      if (nextIndex === currentIndex && ![" ", "Enter"].includes(event.key)) return;

      event.preventDefault();
      if (event.key === " " || event.key === "Enter") {
        setHabitatsSlide(currentIndex);
      } else {
        setHabitatsSlide(nextIndex);
        habitatsSlideControls[nextIndex]?.focus();
      }
    });
  });

  const habitatsShowcase = document.querySelector<HTMLElement>(".habitats-showcase");
  habitatsShowcase?.addEventListener("mouseenter", pauseHabitatsAutoplay);
  habitatsShowcase?.addEventListener("mouseleave", resumeHabitatsAutoplay);
  habitatsShowcase?.addEventListener("focusin", pauseHabitatsAutoplay);
  habitatsShowcase?.addEventListener("focusout", (event) => {
    if (!habitatsShowcase.contains(event.relatedTarget as Node)) resumeHabitatsAutoplay();
  });

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopHabitatsAutoplay();
    else startHabitatsAutoplay();
  });

  habitatsMotionQuery.addEventListener?.("change", () => {
    if (habitatsMotionQuery.matches) stopHabitatsAutoplay();
    else startHabitatsAutoplay();
  });

  if ("ResizeObserver" in window && habitatsScreen) {
    const habitatsFrameObserver = new ResizeObserver(fitHabitatsFrame);
    habitatsFrameObserver.observe(habitatsScreen);
  }
  window.addEventListener("resize", fitHabitatsFrame);
  fitHabitatsFrame();
  startHabitatsAutoplay();

  // Hero film: subtle play button opens a modal player above the page
  const heroPlayBtn = document.getElementById("heroPlayBtn");
  const heroFilmModal = document.getElementById("heroFilmModal");
  const heroFilmClose = document.getElementById("heroFilmClose");
  const heroFilmVideo = document.getElementById("heroFilmVideo") as HTMLVideoElement | null;
  const openHeroFilm = () => {
    if (!heroFilmModal) return;
    heroFilmModal.classList.add("is-open");
    document.body.style.overflow = "hidden";
    if (heroFilmVideo) {
      try {
        heroFilmVideo.currentTime = 0;
        heroFilmVideo.play();
      } catch (e) {
        /* autoplay may be blocked; controls remain */
      }
    }
  };
  const closeHeroFilm = () => {
    if (!heroFilmModal) return;
    heroFilmModal.classList.remove("is-open");
    document.body.style.overflow = "";
    if (heroFilmVideo) heroFilmVideo.pause();
  };
  heroPlayBtn?.addEventListener("click", openHeroFilm);
  heroFilmClose?.addEventListener("click", closeHeroFilm);
  heroFilmModal?.addEventListener("click", (e) => {
    if (e.target === heroFilmModal) closeHeroFilm();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && heroFilmModal?.classList.contains("is-open")) closeHeroFilm();
  });
</script>
