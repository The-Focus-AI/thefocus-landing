---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCapture from "../components/BookCapture.astro";

const companies = ["Apple", "Tesla", "Rivian", "X / Twitter", "Samsung", "Perplexity", "Audible", "Con Edison", "WeaveGrid", "ev.energy", "TezLab", "Steering House"];
---

<BaseLayout
  title="TheFocus.AI — Consulting for the Org Age of AI"
  description="TheFocus.AI helps business leaders build the data, software, and ways of working required for an intelligent organization."
  newsletter={false}
  footerMotto="DATA · SOFTWARE · COOPERATION"
>
  <main>
    <section class="relative overflow-hidden min-h-[760px] flex items-center ledger-grid">
      <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0A] via-[#0A0A0A]/95 to-[#0A0A0A]/70"></div>
      <div class="relative gtm-shell grid lg:grid-cols-12 gap-12 items-center py-20 lg:py-28">
        <div class="lg:col-span-7 reveal">
          <div class="gtm-kicker mb-6">TheFocus.AI · Organization and AI consultancy</div>
          <h1 class="max-w-[8ch] text-6xl sm:text-7xl lg:text-[7.5rem] leading-[0.86] font-semibold tracking-[-0.07em] text-balance">
            The Org Age of AI
          </h1>
          <p class="gtm-lede mt-8">
            AI is changing faster than most organizations can absorb it. <strong class="text-white font-medium">We help
            business leaders build the data, software, and ways of working required for an intelligent organization.</strong>
          </p>
          <a class="gtm-button gtm-button-primary mt-8" href="mailto:wschenk@thefocus.ai?subject=Consulting%20project">Discuss a consulting project</a>
        </div>
        <aside class="lg:col-span-5 gtm-signal-panel p-7 sm:p-9 reveal delay-1" aria-label="Free book offer">
          <div class="gtm-kicker">Free field guide · Complete edition</div>
          <h2 class="mt-10 text-3xl sm:text-4xl leading-[1.02] font-semibold tracking-tight">A practical guide to becoming an intelligent organization.</h2>
          <p class="mt-5 text-[#B0B0B0] text-sm leading-relaxed">Trusted data, software built for a changing organization, human-agent cooperation, and the path from experiments to compounding capability.</p>
          <div class="grid grid-cols-3 border-y border-white/10 mt-10 py-4 mono text-[9px] uppercase text-[#888]">
            <div><b class="block text-xl text-white">8</b>chapters</div><div><b class="block text-xl text-white">31k</b>words</div><div><b class="block text-xl text-white">19</b>figures</div>
          </div>
          <a class="gtm-button w-full mt-6" href="/book/">Explore the free book</a>
        </aside>
      </div>
    </section>

    <section class="gtm-section bg-[#111111]">
      <div class="gtm-shell grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5"><div class="gtm-kicker mb-4">What this means</div><h2 class="gtm-heading">AI adoption is an organizational problem.</h2></div>
        <p class="lg:col-span-7 text-xl sm:text-2xl leading-relaxed text-[#B0B0B0]">Models are becoming abundant. Business context, trusted data, clear authority, and repeatable ways of working are not. <strong class="text-white font-medium">TheFocus.AI helps leaders close that gap</strong>—from deciding where to start through building and transferring the working system.</p>
      </div>
    </section>

    <section class="gtm-section">
      <div class="gtm-shell">
        <div class="grid lg:grid-cols-2 gap-8 items-end mb-10"><div><div class="gtm-kicker mb-3">The experience behind the work</div><h2 class="gtm-heading">Organizations we’ve built for.</h2></div><p class="gtm-lede">Selected organizations from our team’s product, studio, and consulting work—from global platforms to focused operating teams.</p></div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border-l border-t border-white/10">
          {companies.map((company) => <div class="border-r border-b border-white/10 px-4 py-6 text-center font-semibold text-[#999]">{company}</div>)}
        </div>
        <a href="/work/" class="inline-block mt-6 text-sm text-[#B0B0B0] hover:text-white">See selected client work →</a>
      </div>
    </section>

    <section class="gtm-section bg-[#0d0d0d]" id="practices">
      <div class="gtm-shell">
        <div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">Explore what we do</div><h2 class="gtm-heading">Three practices. Each one leads somewhere concrete.</h2></div><p class="gtm-lede lg:col-span-4">Open each practice for a real example, related field note, and a practical next step.</p></div>
        <div class="grid lg:grid-cols-3 mt-12 border-l border-t border-white/10">
          <article class="p-7 border-r border-b border-white/10 flex flex-col"><div class="gtm-kicker">I / Context</div><h3 class="text-3xl font-semibold tracking-tight mt-12">Intelligent Data</h3><p class="text-xl italic text-[#B0B0B0] mt-3">“Can we trust the numbers?”</p><p class="text-[#888] mt-5 leading-relaxed">Connect the systems you already use, define meaning with your experts, and verify quality so people and AI work from the same facts.</p><div class="mono text-[10px] uppercase text-[#B0B0B0] mt-8 pt-5 border-t border-white/10">Outcome · Answers with sources</div><details class="mt-6"><summary class="cursor-pointer gtm-kicker py-4 border-y border-white/10">Explore Intelligent Data</summary><div class="pt-5 text-sm text-[#999] space-y-3"><p>Connect finance and operational data without a disruptive migration, then make every answer cite its source.</p><a class="block text-[#B0B0B0] hover:text-white" href="https://labs.thefocus.ai/dispatch/data-flywheel-pattern/" target="_blank" rel="noopener noreferrer">Labs · The Data Flywheel Pattern ↗</a><a class="gtm-button w-full" href="/data/">See the practice</a></div></details></article>
          <article class="p-7 border-r border-b border-white/10 flex flex-col"><div class="gtm-kicker">II / Action</div><h3 class="text-3xl font-semibold tracking-tight mt-12">Intelligent Software</h3><p class="text-xl italic text-[#B0B0B0] mt-3">“What should software become now?”</p><p class="text-[#888] mt-5 leading-relaxed">Interfaces respond to the person and situation. The lifecycle shifts from fixed features to continuously defining, generating, evaluating, and improving what the organization needs next.</p><div class="mono text-[10px] uppercase text-[#B0B0B0] mt-8 pt-5 border-t border-white/10">Outcome · Software that anticipates needs</div><details class="mt-6"><summary class="cursor-pointer gtm-kicker py-4 border-y border-white/10">Explore Intelligent Software</summary><div class="pt-5 text-sm text-[#999] space-y-3"><p>Replace a recurring manual workflow with bounded software, explicit evaluation, and human review for exceptions.</p><a class="block text-[#B0B0B0] hover:text-white" href="https://labs.thefocus.ai/dispatch/agent-habitat/" target="_blank" rel="noopener noreferrer">Labs · The Agent Habitat ↗</a><a class="gtm-button w-full" href="/software/">See the practice</a></div></details></article>
          <article class="p-7 border-r border-b border-white/10 flex flex-col"><div class="gtm-kicker">III / Cooperation</div><h3 class="text-3xl font-semibold tracking-tight mt-12">Intelligent Organization</h3><p class="text-xl italic text-[#B0B0B0] mt-3">“How do people and agents work together?”</p><p class="text-[#888] mt-5 leading-relaxed">Combine shared rules, review queues, data provenance, and visible human-agent contributions so the organization works together better.</p><div class="mono text-[10px] uppercase text-[#B0B0B0] mt-8 pt-5 border-t border-white/10">Outcome · Capability that compounds safely</div><details class="mt-6"><summary class="cursor-pointer gtm-kicker py-4 border-y border-white/10">Explore Intelligent Organization</summary><div class="pt-5 text-sm text-[#999] space-y-3"><p>Give one team a shared workspace where people assign, review, and retain work done with AI.</p><a class="block text-[#B0B0B0] hover:text-white" href="https://labs.thefocus.ai/dispatch/building-an-intelligent-organization/" target="_blank" rel="noopener noreferrer">Labs · Building an Intelligent Organization ↗</a><a class="gtm-button w-full" href="/organization/">See the practice</a></div></details></article>
        </div>
      </div>
    </section>

    <section class="gtm-section maturity" id="maturity">
      <div class="gtm-shell">
        <div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">The path forward</div><h2 class="gtm-heading">See where you are—and what comes next.</h2></div><p class="gtm-lede lg:col-span-4">Five transitions across six organizational states. Select a level for the practical signs, relevant reading, and next action.</p></div>
        <div class="grid grid-cols-2 md:grid-cols-6 mt-12 border-l border-t border-white/10" role="tablist" aria-label="Six organizational maturity levels">
          {[["L0","Tribal"],["L1","Experimenting"],["L2","Legible"],["L3","Knowledgeable"],["L4","Adaptive"],["L5","Self-improving"]].map(([level, name], index) => <button type="button" role="tab" aria-selected={index === 2 ? "true" : "false"} data-level={index} class:list={["maturity-level min-h-32 p-4 text-left border-r border-b border-white/10 hover:bg-[#556B2F]/20", index === 2 && "is-active"]}><b class="mono text-[10px] text-[#7f9a4d]">{level}</b><span class="block mt-10 text-sm sm:text-base">{name}</span></button>)}
        </div>
        <div class="grid lg:grid-cols-12 gap-8 border-x border-b border-white/10 p-6 sm:p-8 min-h-56" aria-live="polite">
          <div class="lg:col-span-3"><h3 id="level-name" class="text-xl font-semibold">L2 — Legible</h3><div id="level-tag" class="gtm-kicker mt-2">Work machines can understand</div></div>
          <ul id="level-list" class="lg:col-span-6 list-disc pl-5 text-[#B0B0B0] space-y-2"><li>Workflows, rules, exceptions, and ownership are documented.</li><li>The organization can describe what good work looks like.</li><li>Machines can act on context within stated boundaries.</li></ul>
          <div class="lg:col-span-3 flex flex-col gap-3"><a id="level-read" class="gtm-button" href="https://labs.thefocus.ai/dispatch/laddering-up-from-chatboxes-to-autonomy/" target="_blank" rel="noopener noreferrer">Read: Laddering Up ↗</a><a id="level-cta" class="gtm-button" href="mailto:wschenk@thefocus.ai?subject=L2%20AI%20maturity">Discuss this level</a></div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 mt-14 pt-12 border-t border-white/10 items-center"><div><div class="gtm-kicker">Get the complete field guide</div><h3 class="text-3xl sm:text-4xl font-semibold tracking-tight mt-3">Learn every level and how to move between them.</h3><p class="text-[#999] mt-4">Eight chapters connecting maturity, data, software, authority, verification, cooperation, and business value.</p></div><BookCapture label="Get the complete field guide" /></div>
      </div>
    </section>

    <section class="gtm-section bg-[#111111]" id="engagement">
      <div class="gtm-shell grid lg:grid-cols-2 gap-14">
        <div><div class="gtm-kicker mb-3">How consulting works</div><h2 class="gtm-heading">Start with one business problem.</h2><p class="gtm-lede mt-5">We find a valuable constraint, build the smallest working system that moves it, measure the result, and transfer the capability.</p><ol class="mt-8 border-t border-white/10">{[["01","Define the outcome","What is not working, what does it cost, and what would useful improvement look like?"],["02","Build the first working system","Bounded scope, human review, explicit measures, and no speculative roadmap."],["03","Level up from evidence","The first result reveals the next constraint. Each engagement earns the next."]].map(([n,t,c]) => <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-5 border-b border-white/10"><span class="gtm-kicker">{n}</span><div><h3 class="font-semibold">{t}</h3><p class="text-sm text-[#888] mt-1">{c}</p></div></li>)}</ol></div>
        <aside class="gtm-card p-7 sm:p-9"><div class="gtm-kicker">A data-readiness consulting engagement</div><h3 class="text-4xl font-semibold tracking-tight mt-10">The Map</h3><p class="text-[#999] mt-4 leading-relaxed">If fragmented or untrusted data is blocking your AI plans, we spend three weeks identifying where critical information lives, why it disagrees, and the fastest path to trusted answers.</p><div class="mono text-[10px] uppercase tracking-[1px] py-5 my-7 border-y border-white/10">3 weeks · fixed fee · costed implementation plan</div><div class="flex flex-col sm:flex-row gap-3"><a class="gtm-button gtm-button-primary" href="mailto:wschenk@thefocus.ai?subject=Data-readiness%20consulting%20project">Talk about your data</a><a class="gtm-button" href="/data/">See how the Map works</a></div></aside>
      </div>
    </section>

    <section class="gtm-section">
      <div class="gtm-shell"><div class="grid lg:grid-cols-2 gap-8 items-end mb-10"><div><div class="gtm-kicker mb-3">Who you hire</div><h2 class="gtm-heading">Senior people, from strategy through delivery.</h2></div><p class="gtm-lede">The people you meet do the work—and publish what they learn.</p></div><div class="grid md:grid-cols-2 gap-4"><article class="gtm-card p-7"><div class="w-14 h-14 border border-white/20 grid place-items-center mono">WS</div><h3 class="text-2xl font-semibold mt-8">Will Schenk</h3><div class="gtm-kicker mt-1">Co-founder</div><p class="text-[#999] mt-4">Thirty years shipping software. Built TezLab to more than 100,000 users and writes the Org Age field guide.</p><a class="inline-block mt-5 text-sm text-[#B0B0B0] hover:text-white" href="https://labs.thefocus.ai/thoughts/" target="_blank" rel="noopener noreferrer">Read Will’s field notes ↗</a></article><article class="gtm-card p-7"><div class="w-14 h-14 border border-white/20 grid place-items-center mono">BS</div><h3 class="text-2xl font-semibold mt-8">Ben Schippers</h3><div class="gtm-kicker mt-1">Co-founder</div><p class="text-[#999] mt-4">Two decades building products with startups and the Fortune 500. Leads scope, staffing, delivery, and business outcomes.</p><a class="inline-block mt-5 text-sm text-[#B0B0B0] hover:text-white" href="/work/">See the work →</a></article></div></div>
    </section>

    <section class="gtm-section text-center bg-[#556B2F]/10"><div class="gtm-shell"><div class="gtm-kicker">Choose the next step</div><h2 class="gtm-heading mx-auto mt-4">Bring us the business problem—or start with the field guide.</h2><p class="gtm-lede mx-auto mt-6">A focused conversation if you are ready to act. The complete book if you want the framework first.</p><div class="flex flex-col sm:flex-row justify-center gap-3 mt-8"><a class="gtm-button gtm-button-primary" href="mailto:wschenk@thefocus.ai?subject=Consulting%20project">Discuss a consulting project</a><a class="gtm-button" href="/book/">Explore the free book</a></div></div></section>
  </main>
</BaseLayout>

<style>
  .maturity-level.is-active { background: rgb(85 107 47 / 0.28); color: white; }
</style>

<script>
  const levels = [
    { name: "L0 — Tribal", tag: "Tacit knowledge", items: ["The organization runs on memory, habit, and knowing whom to ask.", "Critical rules and exceptions live in people’s heads.", "Machines cannot reliably participate in the work."], read: "https://labs.thefocus.ai/dispatch/laddering-up-from-chatboxes-to-autonomy/", label: "Read: Laddering Up ↗" },
    { name: "L1 — Experimenting", tag: "Individual use", items: ["Individuals use AI, but the work is brittle and isolated.", "Useful practices are not captured or shared.", "Results disappear with the person, so nothing compounds."], read: "https://labs.thefocus.ai/dispatch/how-ai-january-2026/", label: "Read: How AI works ↗" },
    { name: "L2 — Legible", tag: "Work machines can understand", items: ["Workflows, rules, exceptions, and ownership are documented.", "The organization can describe what good work looks like.", "Machines can act on context within stated boundaries."], read: "https://labs.thefocus.ai/dispatch/laddering-up-from-chatboxes-to-autonomy/", label: "Read: Laddering Up ↗" },
    { name: "L3 — Knowledgeable", tag: "Sourced and auditable", items: ["The organization knows what it knows and can prove it.", "Data is connected to agreed meaning and quality checks.", "Answers include sources, limits, and verification."], read: "https://labs.thefocus.ai/dispatch/data-flywheel-pattern/", label: "Read: Data Flywheel ↗" },
    { name: "L4 — Adaptive", tag: "Trusted proactive action", items: ["Systems act on incoming signals before being asked.", "People review exceptions instead of every routine step.", "Permissions and authority match the new workflow."], read: "https://labs.thefocus.ai/dispatch/agent-habitat/", label: "Read: Agent Habitat ↗" },
    { name: "L5 — Self-improving", tag: "Learning from operation", items: ["Human corrections feed back into future work.", "Operating outcomes improve the system over time.", "Internal teams own the controls, measures, and learning loops."], read: "https://labs.thefocus.ai/dispatch/building-an-intelligent-organization/", label: "Read: Intelligent Organization ↗" },
  ];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".maturity-level")];
  const name = document.querySelector<HTMLElement>("#level-name");
  const tag = document.querySelector<HTMLElement>("#level-tag");
  const list = document.querySelector<HTMLUListElement>("#level-list");
  const read = document.querySelector<HTMLAnchorElement>("#level-read");
  const cta = document.querySelector<HTMLAnchorElement>("#level-cta");
  buttons.forEach((button, index) => button.addEventListener("click", () => {
    const level = levels[index];
    if (!level || !name || !tag || !list || !read || !cta) return;
    name.textContent = level.name; tag.textContent = level.tag; list.replaceChildren(...level.items.map((item) => Object.assign(document.createElement("li"), { textContent: item })));
    read.href = level.read; read.textContent = level.label; cta.href = `mailto:wschenk@thefocus.ai?subject=${encodeURIComponent(`${level.name} AI maturity`)}`;
    buttons.forEach((other, otherIndex) => { const active = otherIndex === index; other.classList.toggle("is-active", active); other.setAttribute("aria-selected", String(active)); });
  }));
</script>
