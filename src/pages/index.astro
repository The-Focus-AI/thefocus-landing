---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="TheFocus.AI — Amplifying Intelligence"
  description="We find where AI makes your teams sharper, build it into the workflows they already trust, and teach your team as we go."
  current="method"
  footerMotto="NO RETAINERS · NO PILOTS FOR THEIR OWN SAKE"
>
  <!-- Studio location -->
  <div class="border-b border-white/5 bg-[#0d0d0d]">
    <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-3 flex items-center gap-x-3">
      <span class="w-1.5 h-1.5 rounded-full bg-[#556B2F]"></span>
      <span class="mono text-[11px] tracking-[1.5px] text-[#666]">BROOKLYN, NY</span>
    </div>
  </div>

  <!-- Hero -->
  <div class="relative min-h-[85vh] flex items-end overflow-hidden">
    <!-- Background image stage -->
    <div class="hero-stage absolute inset-0">
      <img
        src="/assets/hero-cinematic-train-b.jpg"
        alt="Brooklyn tech studio at night with a long-exposure subway streaking past the windows"
        class="hero-img absolute inset-0 w-full h-full object-cover object-center"
      />
      <!-- Flickering warm glow, pinned in JS to the pendant in the photo -->
      <div class="lamp-glow"></div>
    </div>
    <!-- Gradient fade: dark at bottom for text, subtle at top -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/70 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0A]/60 to-transparent"></div>
    <!-- Animated subway motion layer: clipped duplicate of the actual train band, above the darkening gradients. -->
    <div class="train-track-area">
      <div class="train-band-motion train-band-core">
        <img src="/assets/hero-cinematic-train-b.jpg" alt="" class="train-band-img" />
      </div>
      <div class="train-band-motion train-band-smear">
        <img src="/assets/hero-cinematic-train-b.jpg" alt="" class="train-band-img" />
      </div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 max-w-screen-xl mx-auto px-5 sm:px-8 pb-16 pt-32 w-full">
      <div class="max-w-2xl hero-reveal">
        <div class="section-label text-[#556B2F] mb-3">Our kind of AI</div>

        <h1
          class="text-5xl sm:text-6xl lg:text-7xl leading-[1.02] font-semibold tracking-tighter"
          aria-label="Amplifying Intelligence."
        >
          <span class="text-[#9db565]" aria-hidden="true">A</span>mplifying <span class="text-[#9db565]" aria-hidden="true">I</span>ntelligence.
        </h1>

        <p class="mt-6 max-w-xl text-xl text-[#B0B0B0]">
          We find where AI makes your teams sharper, build it into the workflows they already trust, and teach your
          team as we go.
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-x-4 mt-9">
          <a
            href="mailto:wschenk@thefocus.ai"
            class="w-full sm:w-auto text-center px-8 py-3.5 bg-white text-black font-medium text-sm hover:bg-white/90 transition-colors"
          >
            Start with an assessment
          </a>
          <a
            href="#method"
            class="w-full sm:w-auto text-center px-8 py-3.5 border border-white/20 hover:bg-white/5 transition-colors text-sm"
          >
            See the method
          </a>
        </div>
      </div>
    </div>

    <!-- Subtle "watch the film" button, blended into the hero (bottom-right) -->
    <button
      id="heroPlayBtn"
      type="button"
      aria-label="Watch the film"
      class="hero-play-btn group absolute bottom-4 right-4 sm:bottom-8 sm:right-8 z-30 flex items-center gap-x-3"
    >
      <span
        class="mono text-[10px] tracking-[2px] uppercase text-white/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden sm:inline"
        >Watch the film</span
      >
      <span
        class="hero-play-ring relative flex items-center justify-center w-12 h-12 rounded-full border border-white/25 bg-black/30 backdrop-blur-sm text-white/85"
      >
        <Icon name="play" class="w-3 h-3 translate-x-[1px]" />
      </span>
    </button>
  </div>

  <!-- Observation -->
  <div class="border-y border-white/10 bg-[#111111]">
    <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-8">
        <div class="col-span-1 md:col-span-6">
          <div class="section-label text-[#556B2F] mb-4">Built together</div>
          <h2 class="text-4xl sm:text-5xl leading-[1.05] tracking-tighter font-semibold">
            <span class="text-[#888]">The best AI keeps humans in charge.</span><br />
            <span class="text-white">We build it together, in the open.</span>
          </h2>
        </div>
        <div class="col-span-1 md:col-span-6">
          <p class="text-[#B0B0B0] text-[17px] leading-relaxed max-w-xl">
            We sit right next to your team and build the real system side by side — AI handling the drudgery, your
            people making the calls that matter. <span class="text-white"
              >We teach the techniques as we go, so the knowledge stays after we've left.</span
            > You get something that works, that your team understands and controls, and that they actually want to use.
          </p>
          <p class="mt-4 text-[#999] text-[15px] leading-relaxed max-w-xl">
            The prompts, the results, even the model — we protect all of it, so you don't have to.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Clients -->
  <div class="border-b border-white/10">
    <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-y-3 mb-8">
        <div class="mono text-[11px] tracking-[1.5px] text-[#666]">WE'VE BUILT FOR</div>
        <a href="/work/" class="text-sm text-[#666] hover:text-white transition-colors">See the work →</a>
      </div>
      <div class="flex flex-wrap items-center gap-x-10 gap-y-6">
        <img src="/assets/logos/apple.svg" alt="Apple" title="Apple" class="h-6 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <img src="/assets/logos/tesla.svg" alt="Tesla" title="Tesla" class="h-5 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="Rivian">RIVIAN</span>
        <img src="/assets/logos/x.svg" alt="X, formerly Twitter" title="X (formerly Twitter)" class="h-5 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <img src="/assets/logos/samsung.svg" alt="Samsung" title="Samsung" class="h-6 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <img src="/assets/logos/perplexity.svg" alt="Perplexity" title="Perplexity" class="h-6 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <img src="/assets/logos/audible.svg" alt="Audible" title="Audible" class="h-6 w-auto opacity-45 hover:opacity-90 transition-opacity" />
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="Con Edison">conEdison</span>
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="A+E Networks">A+E</span>
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="WeaveGrid">WeaveGrid</span>
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="ev.energy">ev.energy</span>
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="TezLab">TezLab</span>
        <span class="text-[#888] hover:text-[#ccc] transition-colors font-semibold tracking-tight text-[17px] leading-none" title="Steering House">Steering House</span>
      </div>
    </div>
  </div>

  <!-- Method -->
  <div id="method" class="max-w-screen-xl mx-auto px-5 sm:px-8 py-16 scroll-mt-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-8 items-end mb-10">
      <div class="col-span-1 md:col-span-8">
        <div class="section-label text-[#556B2F] mb-2 reveal">How we work</div>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter reveal delay-1">Strategy · Build · Teach</h2>
      </div>
      <p class="col-span-1 md:col-span-4 text-[#888] text-sm leading-relaxed reveal delay-2">
        Three moves, one thread: decide what matters, build the system, teach the team to keep going.
      </p>
    </div>

    <div class="method-system reveal delay-2 rounded-2xl">
      <div class="method-rail"></div>
      <div class="grid md:grid-cols-[0.22fr_1fr_1.18fr_1fr]">
        <div class="hidden md:flex items-center justify-center border-r border-white/10 px-4 py-8">
          <div class="method-side-label mono text-[10px] text-[#666]">THE OPERATING THREAD</div>
        </div>

        <!-- Strategy -->
        <div class="method-step" data-num="01">
          <div class="method-step-body">
            <div class="mono text-xs text-[#556B2F] mb-5 tracking-[1px]">01 — STRATEGY</div>
            <div class="text-xl font-medium mb-4">Settle the thinking before anything gets built.</div>
            <div class="text-[#999] text-[14px] leading-relaxed">
              For boards and teams that want a real plan first. We work with your execs and leads to find where AI
              genuinely helps your people — and shape a strategy you can take to the board.
            </div>
            <div class="mt-5 pt-4 border-t border-white/10">
              <a
                href="/assets/thefocus-strategy-brief-sample.pdf"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-x-2 text-[13px] text-[#B0B0B0] hover:text-white transition-colors"
              >
                Example: a sample board strategy brief <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Build -->
        <div class="method-step method-step-build" data-num="02">
          <div class="method-step-body">
            <div class="mono text-xs text-[#556B2F] mb-5 tracking-[1px]">02 — BUILD</div>
            <div class="text-2xl font-semibold tracking-tight mb-4">Build tools that fit how your team works.</div>
            <div class="text-[#B0B0B0] text-[15px] leading-relaxed">
              We build systems that handle the repetitive work — so your team can spend its time on judgment,
              creativity, and the calls a model can't make.
            </div>
            <div class="mt-5 pt-4 border-t border-white/10 text-[#888] text-[13px] leading-relaxed">
              We're not loyal to any model — frontier where it pays, open weights in your cloud where it doesn't. You
              own what comes out.
            </div>
          </div>
        </div>

        <!-- Teach -->
        <div class="method-step" data-num="03">
          <div class="method-step-body">
            <div class="mono text-xs text-[#556B2F] mb-5 tracking-[1px]">03 — TEACH</div>
            <div class="text-xl font-medium mb-4">Teach the people who want to learn.</div>
            <div class="text-[#999] text-[14px] leading-relaxed">
              We bring your team along as we build, so they own it after we go. They come out more capable — then teach
              the rest of your organization what's possible.
            </div>
            <a
              href="#team-keeps"
              class="inline-flex items-center gap-x-2 mt-5 text-[13px] text-[#B0B0B0] hover:text-white transition-colors"
            >
              What your team keeps <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- In practice / lifestyle -->
  <div class="border-t border-white/10">
    <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="col-span-1 lg:col-span-6">
          <div class="relative border border-white/10">
            <img
              src="/assets/studio-brooklyn-hero-b.jpg"
              alt="Team mapping workflows on a whiteboard in a Brooklyn studio"
              class="w-full object-cover aspect-[3/2]"
            />
            <div class="absolute bottom-0 left-0 right-0 px-4 py-3 bg-gradient-to-t from-black/80 to-transparent">
              <div class="flex items-center justify-between">
                <span class="mono text-[11px] tracking-[1px] text-[#B0B0B0]">FIG. 02 — MAPPING THE WORK</span>
                <span class="w-2 h-2 bg-[#556B2F]"></span>
              </div>
              <div class="mt-2 mono text-[10px] text-[#888]">The workflow, drawn before the build.</div>
            </div>
          </div>
        </div>
        <div class="col-span-1 lg:col-span-6">
          <div class="section-label text-[#556B2F] mb-3">In practice</div>
          <h2 class="text-3xl leading-tight tracking-tight font-semibold mb-5">
            We start by drawing your business the way it actually runs.
          </h2>
          <p class="text-[#B0B0B0] text-[15px] leading-relaxed mb-4">
            Before a line of code, we map the real workflow — the handoffs, the exceptions, the decisions that quietly
            cost your team time and energy. The picture is usually messier than the org chart. That's the point.
          </p>
          <p class="text-[#999] text-[14px] leading-relaxed">
            That map tells us where AI frees your people up — and, just as often, where human judgment is the whole
            value.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Ledger texture band / pull quote -->
  <div class="relative border-y border-white/10 overflow-hidden">
    <img src="/assets/studio-texture-dark.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-[0.3]" />
    <div class="absolute inset-0 bg-[#0A0A0A]/60"></div>
    <div class="relative max-w-screen-xl mx-auto px-5 sm:px-8 py-20">
      <p class="max-w-3xl text-2xl md:text-3xl font-semibold tracking-tight leading-snug">
        "AI doesn't replace good people — it multiplies what they already do best. But you have to understand your own
        work first. That's the part most companies skip."
      </p>
      <div class="mt-5 mono text-[11px] tracking-[1px] text-[#666]">WILL SCHENK · THEFOCUS.AI</div>
    </div>
  </div>

  <!-- What your team keeps -->
  <section id="team-keeps" class="team-keeps">
    <div class="relative z-10 max-w-screen-xl mx-auto px-5 sm:px-8 py-14 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-4 items-end mb-8">
        <div class="col-span-1 lg:col-span-7">
          <div class="section-label text-[#556B2F] mb-3 reveal">What your team keeps</div>
          <h2 class="text-3xl sm:text-4xl leading-[1.06] tracking-tighter font-semibold reveal delay-1">
            We build it with your team. Then they build it without us.
          </h2>
        </div>
        <div class="col-span-1 lg:col-span-5 reveal delay-2">
          <p class="text-[#9a9a9a] text-[15px] leading-relaxed">
            Bring a project you actually need built. We sit down with your team and build it together — the real thing,
            not a demo. They learn how software gets made now by making it. When we're done, the work ships and the
            skills stay.
          </p>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-3">
        <article class="tk-card reveal">
          <div class="tk-shot">
            <span class="tk-tag">Real work</span>
            <img src="/assets/studio-room-2.jpg" alt="Two people working through code together at a laptop" />
          </div>
          <div class="tk-body">
            <div class="mono text-[10px] tracking-[1.4px] text-[#7f9a4d] mb-2">01 · BUILD SOMETHING REAL</div>
            <h3 class="text-lg font-semibold tracking-tight mb-1.5">No sample apps.</h3>
            <p class="text-[#9a9a9a] text-[13.5px] leading-relaxed">
              You bring something your business actually needs. We build the real thing — not a toy version — and it
              ships into your work.
            </p>
          </div>
        </article>

        <article class="tk-card reveal delay-1">
          <div class="tk-shot">
            <span class="tk-tag">Side by side</span>
            <img src="/assets/studio-room-4.jpg" alt="A team building something together at a laptop" />
          </div>
          <div class="tk-body">
            <div class="mono text-[10px] tracking-[1.4px] text-[#7f9a4d] mb-2">02 · LEARN BY DOING</div>
            <h3 class="text-lg font-semibold tracking-tight mb-1.5">We sit next to your team.</h3>
            <p class="text-[#9a9a9a] text-[13.5px] leading-relaxed">
              No manuals, no slide decks. We work next to your people on the real problem, so they pick up the judgment
              — what to hand off, what to check, what's not worth trusting yet.
            </p>
          </div>
        </article>

        <article class="tk-card reveal delay-2">
          <div class="tk-shot">
            <span class="tk-tag">It's yours</span>
            <img src="/assets/studio-room-5.jpg" alt="A team walking through their work together while one person explains it" />
          </div>
          <div class="tk-body">
            <div class="mono text-[10px] tracking-[1.4px] text-[#7f9a4d] mb-2">03 · BRING IT BACK</div>
            <h3 class="text-lg font-semibold tracking-tight mb-1.5">Then they do it without us.</h3>
            <p class="text-[#9a9a9a] text-[13.5px] leading-relaxed">
              Your people go home with the thing you built and the know-how to build the next one. That's the point —
              not another vendor you depend on.
            </p>
          </div>
        </article>
      </div>

      <div class="team-keeps-ledger mt-3 px-5 py-4 reveal delay-3">
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
          <div class="mono text-[10px] tracking-[1.4px] text-[#556B2F] shrink-0">HABITATS KEEPS THE WORK</div>
          <p class="text-[#9a9a9a] text-[13.5px] leading-relaxed">
            The whole build gets written down as it happens — what you tried, what worked, what to skip next time.
            Months later, the team can still look it up.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Habitats (our product) -->
  <div class="habitats-showcase border-t border-white/10">
    <div class="relative z-10 max-w-screen-xl mx-auto px-5 sm:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-9 lg:gap-12 items-center">
        <div class="lg:col-span-4">
          <div class="habitats-copy">
            <div class="section-label text-[#556B2F] mb-4">Our product · Habitats</div>
            <h2
              class="text-4xl sm:text-5xl leading-[1.04] tracking-tighter font-semibold mb-6"
              aria-label="All Intelligence, in one place."
            >
              <span class="text-[#9db565]" aria-hidden="true">A</span>ll <span class="text-[#9db565]" aria-hidden="true">I</span>ntelligence, in one place.
            </h2>
            <p class="text-[#B0B0B0] text-[16px] leading-relaxed mb-8">
              One shared place where your team uses AI together — so the best ways of working get seen, copied, and
              kept, instead of stuck on one person's screen.
            </p>
          </div>

          <div class="habitats-step-grid" role="radiogroup" aria-label="Habitats product preview">
            <button class="habitats-slide-control" type="button" role="radio" aria-checked="true" tabindex="0" data-habitats-slide="0">
              <span class="habitats-radio-dot" aria-hidden="true"></span>
              <span class="habitats-step-number">01</span>
              <span class="habitats-step-title">Work together</span>
            </button>
            <button class="habitats-slide-control" type="button" role="radio" aria-checked="false" tabindex="-1" data-habitats-slide="1">
              <span class="habitats-radio-dot" aria-hidden="true"></span>
              <span class="habitats-step-number">02</span>
              <span class="habitats-step-title">Learn from others</span>
            </button>
            <button class="habitats-slide-control" type="button" role="radio" aria-checked="false" tabindex="-1" data-habitats-slide="2">
              <span class="habitats-radio-dot" aria-hidden="true"></span>
              <span class="habitats-step-number">03</span>
              <span class="habitats-step-title">Build and share</span>
            </button>
          </div>

          <p id="habitats-slide-note" class="mt-5 text-[#8D8D8D] text-[14px] leading-relaxed min-h-[44px]">
            When your team works in the same space, the best AI results get shared — not trapped in one person's
            private chat.
          </p>

          <div class="mt-7">
            <a
              href="/habitats/"
              class="inline-flex items-center gap-x-2 text-sm text-[#D8D8D8] hover:text-white transition-colors border-b border-white/20 hover:border-white/60 pb-1"
            >
              See how Habitats works <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="hidden lg:block lg:col-span-8">
          <div class="habitats-display">
            <div class="habitats-screen aspect-[1480/900]">
              <div id="habitats-live-stage" class="habitats-live-stage">
                <iframe
                  id="habitats-slide-frame"
                  src="/assets/habitats-marketplace.html"
                  title="Habitats agent marketplace live preview"
                  tabindex="-1"
                  aria-hidden="true"></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Proof / Case studies -->
  <section class="cs-section border-t border-white/10 overflow-hidden">
    <div class="cs-glow cs-glow--amber"></div>
    <div class="cs-glow cs-glow--olive"></div>

    <!-- Intro -->
    <div class="relative z-10 max-w-screen-xl mx-auto px-5 sm:px-8 pt-16 pb-10">
      <div class="reveal max-w-2xl">
        <div class="section-label text-[#556B2F] mb-2">Proof</div>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tighter">We'd rather show you than pitch you.</h2>
        <p class="mt-4 text-[#B0B0B0] text-lg leading-relaxed">
          A few things we've built — and what changed because of them.
        </p>
      </div>
    </div>

    <!-- Featured: TezLab editorial -->
    <article class="cs-feature relative z-10 border-t border-white/10">
      <!-- Full-bleed hero with cinematic light sweep -->
      <a href="/work/#tezlab" class="group block relative w-full h-[60vh] min-h-[420px] overflow-hidden">
        <img
          src="/assets/cs-tezlab-hero.jpg"
          alt="Long-exposure highway light trails at dusk"
          class="cs-feature-img absolute inset-0 w-full h-full object-cover"
        />
        <div class="cs-sweep"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0A]/55 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0">
          <div class="max-w-screen-xl mx-auto px-5 sm:px-8 pb-10">
            <div class="max-w-3xl reveal">
              <div class="mono text-[11px] tracking-[1.5px] text-[#556B2F] mb-4">FEATURED · TEZLAB</div>
              <h3 class="text-3xl sm:text-5xl font-semibold tracking-tighter leading-[1.03]">
                Drivers can ask about their Tesla &amp; Rivian data in plain English — and 27% more converted.
              </h3>
            </div>
          </div>
        </div>
      </a>

      <!-- Meta strip -->
