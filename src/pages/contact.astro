---
import BaseLayout from "../layout/BaseLayout.astro";
import EmailSignup from "../components/email-signup.astro";
---

<BaseLayout
  pageTitle="Contact | TheFocus.AI"
  description="Talk to a principal at TheFocus.AI. Email us directly or subscribe to the newsletter to follow our work."
  category="contact"
>
  <div class="max-w-3xl mx-auto">
    <section class="py-8 md:py-16">
      <p class="text-xs uppercase tracking-[0.2em] text-petrol mb-6 font-medium">Get in touch</p>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-ink leading-tight mb-6">
        Talk to a principal
      </h1>
      <p class="text-xl md:text-2xl text-graphite leading-relaxed mb-8">
        Every engagement at TheFocus.AI is principal-led. The fastest way to start a conversation is to email us directly — one of the founders will reply.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href="mailto:hey@thefocus.ai?subject=Talk%20to%20a%20principal"
          class="inline-block px-8 py-4 bg-petrol text-paper font-medium uppercase text-sm tracking-wider rounded-full hover:bg-petrol/90 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 text-center"
        >
          hey@thefocus.ai
        </a>
        <a
          href="/capabilities"
          class="inline-block px-8 py-4 border-2 border-ink/20 text-ink font-medium uppercase text-sm tracking-wider rounded-full hover:border-petrol hover:text-petrol hover:-translate-y-0.5 transition-all duration-200 text-center"
        >
          See the framework
        </a>
      </div>

      <div class="prose prose-lg max-w-none">
        <h2 class="text-2xl font-semibold text-ink mt-12 mb-4">What to put in the email</h2>
        <ul class="text-graphite leading-relaxed">
          <li>Who you are and what your team does.</li>
          <li>The problem you're trying to solve with AI.</li>
          <li>Any constraints — timeline, regulated industry, existing stack.</li>
        </ul>

        <p class="text-graphite leading-relaxed mt-8">
          Not ready to talk yet? Subscribe below — we send one short essay each week on shipping production AI.
        </p>
      </div>

      <div class="mt-8">
        <EmailSignup />
      </div>
    </section>
  </div>
</BaseLayout>
