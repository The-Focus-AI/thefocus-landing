---
import BaseLayout from "../layouts/BaseLayout.astro";
import PracticeNav from "../components/PracticeNav.astro";

const lifecycle = [["01","Intent","A person describes one bounded capability."],["02","Declaration","The habitat’s resources and behavior become explicit."],["03","Isolated runtime","Code and dependencies materialize inside a container."],["04","Live interface","Components appear and change while the system runs."],["05","Observed behavior","People see what executes and how it behaves."],["06","Revised artifacts","Human-visible code and declarations are changed again."]];
const boundaries = [["01","Separate containers","Habitats execute in isolated runtimes rather than sharing one undifferentiated process."],["02","Scoped credentials","Each environment receives the access intended for its bounded job."],["03","Persistent state","Workspace state survives runtime changes instead of disappearing with a generated response."],["04","Iframe boundary","Foreign components render across an iframe boundary, separating generated surfaces from the host."],["05","Visible artifacts","Executable code and declarations remain human-visible and available for review."],["06","Reconciled operation","Fleet start and stop are explicit desired states, checked against observed state."]];
---

<BaseLayout title="Intelligent Software — TheFocus.AI" description="Purpose-built AI workspaces that take shape around the work, grounded in Gaia, the evolving runtime in Umwelten." current="software" newsletter={false}>
  <main id="top">
    <section class="gtm-section ledger-grid min-h-[760px] flex items-center"><div class="gtm-shell grid lg:grid-cols-12 gap-12 items-center"><div class="lg:col-span-7"><div class="gtm-kicker mb-6">Intelligent Software · A working direction</div><h1 class="max-w-[10ch] text-6xl sm:text-7xl lg:text-8xl leading-[0.88] font-semibold tracking-[-0.065em]">Software that takes shape around the work.</h1><p class="gtm-lede mt-8"><strong class="text-white">Describe a bounded capability. Materialize its environment. Let the interface evolve with use.</strong> Gaia is an evolving intelligent runtime for creating, configuring, operating, and composing purpose-built AI workspaces.</p><div class="flex flex-col sm:flex-row gap-3 mt-8"><a class="gtm-button gtm-button-primary" href="mailto:wschenk@thefocus.ai?subject=Intelligent%20Software%20project">Explore one software workflow</a><a class="gtm-button" href="#control-plane">See the control plane</a></div></div>
      <section class="lg:col-span-5 gaia-console border border-white/25 bg-[#080808]" id="control-plane" aria-label="Interactive Gaia control plane demonstration"><div class="flex justify-between p-3 border-b border-white/20 mono text-[9px]"><span>GAIA / HABITAT CONTROL</span><span class="text-[#9db565]">● RUNTIME LIVE</span></div><div class="grid grid-cols-[5rem_1fr] sm:grid-cols-[7rem_1fr] min-h-[470px]"><div class="border-r border-white/20 py-3" role="tablist" aria-label="Control plane views">{[["habitat","Habitat"],["fleet","Fleet"],["events","Events"]].map(([panel,label], index) => <button class:list={["gaia-tab w-full px-3 py-3 text-left mono text-[9px] border-l-4 border-transparent", index === 0 && "is-active"]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`panel-${panel}`} data-panel={panel}>{label}</button>)}</div><div class="p-3 sm:p-5 min-w-0">
        <section class="gaia-panel is-active" id="panel-habitat" role="tabpanel"><div class="mono text-[9px] text-[#999] mb-6">workspace / operations-clock</div><div class="flex justify-between pb-4 border-b border-white/20"><b class="mono">OPS CLOCK</b><span class="mono text-[9px] text-[#9db565]">RUNNING :3000</span></div><div class="grid sm:grid-cols-2 border-l border-t border-white/20 my-4">{[["Model","configured / scoped"],["State","persistent volume"],["Tools","workspace set"],["Boundary","isolated container"]].map(([key,value]) => <div class="p-3 border-r border-b border-white/20 mono text-[9px] text-[#999]">{key}<span class="block mt-1 text-white">{value}</span></div>)}</div><div class="component-stage min-h-44 border border-dashed border-white/30 grid place-items-center text-center"><div id="clock" class="mono text-3xl sm:text-4xl tracking-tighter">00:00:00<small class="block mt-3 text-[8px] tracking-[1px] text-[#9db565] uppercase">Generated component · live</small></div></div><div class="grid grid-cols-2 gap-2 mt-3"><button class="gtm-button !min-h-10 !p-2" type="button" id="update-component">Hot-update</button><button class="gtm-button !min-h-10 !p-2" type="button" id="toggle-component">Remove</button></div></section>
        <section class="gaia-panel" id="panel-fleet" role="tabpanel" hidden><div class="mono text-[9px] text-[#999] mb-6">composed fleet / child status mounts</div>{[["research-habitat",true],["operations-clock",true],["review-desk",false]].map(([name,on]) => <div class="fleet-row grid grid-cols-[1fr_auto] gap-2 py-4 border-b border-white/20 mono text-[9px]"><span>{name}<small class="block text-[#999] mt-1">{on ? "child status view mounted" : "reconciled: stopped"}</small></span><button type="button" class:list={["border border-white/20 px-2", on && "is-on"]}>{on ? "STOP" : "START"}</button></div>)}</section>
        <section class="gaia-panel" id="panel-events" role="tabpanel" hidden><div class="mono text-[9px] text-[#999] mb-6">observed behavior / event ledger</div><ul class="mono text-[9px] leading-relaxed">{["09:41:02 interface.component mounted","09:40:59 runtime.start reconciled","09:40:57 artifact written: clock","09:40:54 declaration accepted"].map((event) => <li class="py-3 border-b border-white/20">{event}</li>)}</ul></section>
      </div></div></section>
    </div></section>

    <section class="gtm-section bg-[#556B2F]/15"><div class="gtm-shell grid lg:grid-cols-12 gap-10"><div class="lg:col-span-5"><div class="gtm-kicker mb-3">Not another fixed application</div><h2 class="gtm-heading">A runtime for bounded habitats.</h2></div><p class="lg:col-span-7 text-xl sm:text-2xl leading-relaxed text-[#B0B0B0]">Each habitat can carry its own <strong class="text-white">code, tools, model, data, credentials, sessions, and interface.</strong> Gaia makes those environments operable and composable—not merely generated and handed off.</p></div></section>

    <section class="gtm-section" id="lifecycle"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">The changed lifecycle</div><h2 class="gtm-heading">From request to revised artifact.</h2></div><p class="gtm-lede lg:col-span-4">Software can remain visible and editable while it runs. A declaration becomes an environment; use creates evidence for the next revision.</p></div><div class="grid grid-cols-2 lg:grid-cols-6 mt-12 border-l border-t border-white/10">{lifecycle.map(([n,title,copy]) => <article class="p-4 sm:p-5 min-h-52 border-r border-b border-white/10"><b class="gtm-kicker">{n}</b><h3 class="font-semibold mt-14">{title}</h3><p class="text-xs text-[#888] mt-3">{copy}</p></article>)}</div><div class="gtm-signal-panel p-5 mt-6 grid lg:grid-cols-3 gap-4"><b class="gtm-kicker">A small but real demonstration</b><p class="lg:col-span-2 text-sm text-[#B0B0B0]">In a Gaia test and demo prompt, the system creates a clock component. The point is not the clock—it is that a component can appear, hot-update, and be removed without stopping the runtime. Try those controls above.</p></div></div></section>

    <section class="gtm-section bg-[#111111]"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">Inside the control plane</div><h2 class="gtm-heading">One habitat. Its own operating context.</h2></div><p class="gtm-lede lg:col-span-4">Gaia coordinates the pieces required to make an AI workspace concrete, inspectable, and part of a larger fleet.</p></div><div class="grid md:grid-cols-2 lg:grid-cols-4 mt-12 border-l border-t border-white/10">{[["01 / Materialize","Workspace","Code, tools, model configuration, data, and persistent state live together as explicit artifacts.","declaration → container"],["02 / Operate","Runtime","Start and stop are reconciled. Sessions and credentials remain scoped to the habitat.","desired ↔ observed"],["03 / Interface","Live surface","Component and layout changes can mount, hot-update, or disappear while the process continues.","artifact → visible UI"],["04 / Compose","Fleet","Parent workspaces mount child status views and reconcile start/stop across composed habitats.","children → fleet view"]].map(([n,title,copy,code]) => <article class="p-6 min-h-72 border-r border-b border-white/10 flex flex-col"><span class="gtm-kicker">{n}</span><h3 class="text-2xl font-semibold mt-14">{title}</h3><p class="text-sm text-[#888] mt-4">{copy}</p><code class="mono text-[10px] text-[#9db565] mt-auto">{code}</code></article>)}</div></div></section>

    <section class="gtm-section" id="boundaries"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">Safety is architecture</div><h2 class="gtm-heading">Useful freedom needs hard edges.</h2></div><p class="gtm-lede lg:col-span-4">A dynamic system should make authority, execution, and change easier to inspect—not hide them behind a chat box.</p></div><div class="grid md:grid-cols-2 mt-12 border-l border-t border-white/10">{boundaries.map(([n,title,copy]) => <article class="grid grid-cols-[2.5rem_1fr] gap-4 p-6 border-r border-b border-white/10"><b class="gtm-kicker">{n}</b><div><h3 class="text-xl font-semibold">{title}</h3><p class="text-sm text-[#888] mt-2">{copy}</p></div></article>)}</div></div></section>

    <section class="gtm-section bg-[#0d0d0d]"><div class="gtm-shell"><div class="grid lg:grid-cols-12 gap-8 items-end"><div class="lg:col-span-8"><div class="gtm-kicker mb-3">What we will not pretend</div><h2 class="gtm-heading">Working runtime. Evolving practice.</h2></div><p class="gtm-lede lg:col-span-4">Credibility comes from naming the current boundary as clearly as the direction.</p></div><div class="grid md:grid-cols-2 mt-12 border-l border-t border-white/10">{[["Generated changes still need verification.","Human-visible artifacts and runtime boundaries support review; they do not make generated code automatically correct."],["Live-model authoring is manually tested.","The dynamic lifecycle works, but its live-model authoring path is not presented as comprehensively automated validation."],["Gaia is not a universal no-code app generator.","It is a working, evolving runtime for purpose-built habitats with bounded capabilities."],["Evaluation is adjacent, not an automatic gate.","Evaluation exists in Umwelten, but it does not automatically gate every Gaia-generated component today."]].map(([title,copy]) => <article class="p-6 border-r border-b border-white/10"><h3 class="text-xl font-semibold">{title}</h3><p class="text-sm text-[#888] mt-3">{copy}</p></article>)}</div></div></section>

    <section class="gtm-section bg-[#556B2F]/15" id="evidence"><div class="gtm-shell"><div class="gtm-kicker mb-3">Read the implementation trail</div><h2 class="gtm-heading">Source, framing, and the test.</h2><div class="grid md:grid-cols-3 mt-12 border-l border-t border-white/10">{[["Working source · GitHub","The-Focus-AI / umwelten","https://github.com/The-Focus-AI/umwelten"],["Labs dispatch","The Agent Habitat","https://labs.thefocus.ai/dispatch/agent-habitat/"],["Labs dispatch","The Car Wash Test","https://labs.thefocus.ai/dispatch/the-car-wash-test/"]].map(([type,title,href]) => <a class="p-6 min-h-56 border-r border-b border-white/10 flex flex-col hover:bg-white/5" href={href} target="_blank" rel="noopener noreferrer"><small class="gtm-kicker">{type}</small><h3 class="text-2xl font-semibold mt-auto">{title}</h3><span class="gtm-kicker mt-5">Read ↗</span></a>)}</div></div></section>
    <PracticeNav current="software" />
    <section class="gtm-section text-center"><div class="gtm-shell"><div class="gtm-kicker">Start with one bounded capability</div><h2 class="gtm-heading mx-auto mt-4">What work should your software take shape around?</h2><p class="gtm-lede mx-auto mt-6">Bring a workflow where fixed software forces people to carry the changing context. We will explore the runtime, interface, boundaries, and verification it would require.</p><a class="gtm-button gtm-button-primary mt-8" href="mailto:wschenk@thefocus.ai?subject=Intelligent%20Software%20project">Explore one software workflow</a></div></section>
  </main>
</BaseLayout>

<style>.gaia-tab.is-active { border-left-color: #7f9a4d; background: rgb(85 107 47 / .2); color: white; }.gaia-panel:not(.is-active) { display: none; }.component-stage.is-empty { color: #777; }.fleet-row button.is-on { background: rgb(85 107 47 / .4); }</style>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".gaia-tab")]; const panels = [...document.querySelectorAll<HTMLElement>(".gaia-panel")];
  function selectTab(index: number) { tabs.forEach((tab, i) => { const active = i === index; tab.classList.toggle("is-active", active); tab.setAttribute("aria-selected", String(active)); tab.tabIndex = active ? 0 : -1; }); panels.forEach((panel, i) => { panel.classList.toggle("is-active", i === index); panel.hidden = i !== index; }); }
  tabs.forEach((tab, index) => { tab.tabIndex = index === 0 ? 0 : -1; tab.addEventListener("click", () => selectTab(index)); tab.addEventListener("keydown", (event) => { if (!["ArrowDown","ArrowUp","Home","End"].includes(event.key)) return; event.preventDefault(); const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (event.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length; selectTab(next); tabs[next]?.focus(); }); });
  function tick() { const clock = document.querySelector<HTMLElement>("#clock"); if (clock) clock.childNodes[0]!.nodeValue = new Date().toLocaleTimeString("en-US", { hour12: false }); } tick(); window.setInterval(tick, 1000);
  const stage = document.querySelector<HTMLElement>(".component-stage"); const toggle = document.querySelector<HTMLButtonElement>("#toggle-component"); let shown = true; let updated = false;
  toggle?.addEventListener("click", () => { shown = !shown; stage?.classList.toggle("is-empty", !shown); if (stage) stage.innerHTML = shown ? '<div id="clock" class="mono text-3xl sm:text-4xl tracking-tighter">00:00:00<small class="block mt-3 text-[8px] tracking-[1px] text-[#9db565] uppercase">Generated component · live</small></div>' : "COMPONENT REMOVED · RUNTIME CONTINUES"; if (toggle) toggle.textContent = shown ? "Remove" : "Mount"; tick(); });
  document.querySelector("#update-component")?.addEventListener("click", () => { if (!shown || !stage) return; updated = !updated; stage.classList.toggle("bg-[#556B2F]/20", updated); const small = stage.querySelector("small"); if (small) small.textContent = updated ? "Hot-update applied · live" : "Generated component · live"; });
  document.querySelectorAll<HTMLButtonElement>(".fleet-row button").forEach((button) => button.addEventListener("click", () => { const on = button.classList.toggle("is-on"); button.textContent = on ? "STOP" : "START"; const status = button.parentElement?.querySelector("small"); if (status) status.textContent = on ? "child status view mounted" : "reconciled: stopped"; }));
</script>
