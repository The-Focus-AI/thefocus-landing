---
interface Props {
  label?: string;
}
const { label = "Get the complete edition — free" } = Astro.props;
---

<div class="border border-[#556B2F]/60 bg-[#556B2F]/10 p-6 sm:p-7">
  <div class="gtm-kicker mb-3">{label}</div>
  <form class="flex flex-col sm:flex-row gap-3" aria-label="Book email capture preview" data-book-capture>
    <label class="sr-only" for={`book-email-${label.replaceAll(" ", "-").toLowerCase()}`}>Work email</label>
    <input
      id={`book-email-${label.replaceAll(" ", "-").toLowerCase()}`}
      type="email"
      placeholder="Work email"
      class="min-w-0 flex-1 bg-[#0A0A0A] border border-white/15 px-4 py-3 text-sm placeholder:text-[#666] focus:outline-none focus:border-[#556B2F]"
    />
    <button type="button" class="gtm-button gtm-button-primary">Send me the book</button>
  </form>
  <p class="mt-3 mono text-[9px] leading-relaxed tracking-[1px] uppercase text-[#999]">
    Email capture preview · delivery integration forthcoming
  </p>
</div>
