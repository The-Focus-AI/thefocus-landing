---
interface Props {
  motto?: string;
}
const { motto = "YOUR DATA · YOUR IP · YOUR WALLS · YOUR WEIGHTS" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
  <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-8">
      <div class="col-span-2 md:col-span-5">
        <a href="/" class="flex items-center gap-x-2 mb-4">
          <img src="/assets/logo-mark.svg" alt="" aria-hidden="true" class="w-5 h-5 shrink-0" />
          <span class="font-semibold tracking-tight text-lg">TheFocus<span class="text-[#556B2F]">.AI</span></span>
        </a>
        <p class="text-[#666] text-sm max-w-xs leading-relaxed">
          AI that makes your team better at the work they already do. We find where it helps, build the few things
          worth building, and leave them sharper than we found them.
        </p>
      </div>
      <div class="col-span-1 md:col-span-3">
        <div class="mono text-[11px] tracking-[1px] text-[#666] mb-4">NAVIGATE</div>
        <ul class="space-y-3 text-sm text-[#B0B0B0]">
          <li><a href="/#method" class="hover:text-white transition-colors">Method</a></li>
          <li><a href="/work/" class="hover:text-white transition-colors">Work</a></li>
          <li><a href="/habitats/" class="hover:text-white transition-colors">Habitats</a></li>
          <li><a href="/studio/" class="hover:text-white transition-colors">Studio</a></li>
          <li><a href="https://labs.thefocus.ai" class="hover:text-white transition-colors">Labs ↗</a></li>
        </ul>
      </div>
      <div class="col-span-1 md:col-span-4">
        <div class="mono text-[11px] tracking-[1px] text-[#666] mb-4">CONTACT</div>
        <ul class="space-y-3 text-sm text-[#B0B0B0]">
          <li>
            <a href="mailto:wschenk@thefocus.ai" class="hover:text-white transition-colors break-words"
              >wschenk@thefocus.ai</a
            >
          </li>
          <li><a href="mailto:wschenk@thefocus.ai" class="hover:text-white transition-colors">Start a project →</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-y-3">
      <div class="mono text-[11px] tracking-[1px] text-[#555]">© {year} THEFOCUS</div>
      <div class="mono text-[11px] tracking-[1px] text-[#555]">{motto}</div>
    </div>
  </div>
</footer>
