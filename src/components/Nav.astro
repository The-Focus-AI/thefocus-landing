---
import Icon from "./Icon.astro";

interface Props {
  current?: "method" | "work" | "habitats" | "studio";
}
const { current } = Astro.props;

const links = [
  { href: "/#method", label: "Method", key: "method" },
  { href: "/work/", label: "Work", key: "work" },
  { href: "/habitats/", label: "Habitats", key: "habitats" },
  { href: "/studio/", label: "Studio", key: "studio" },
];
---

<nav class="border-b border-white/10 sticky top-0 z-40 bg-[#0A0A0A]/90 backdrop-blur">
  <div class="max-w-screen-xl mx-auto px-5 sm:px-8 py-5 flex items-center justify-between">
    <a href="/" class="flex items-center gap-x-2">
      <img src="/assets/logo-mark.svg" alt="" aria-hidden="true" class="logo-mark-focus w-5 h-5 shrink-0" />
      <span class="font-semibold tracking-tight text-lg">TheFocus<span class="text-[#556B2F]">.AI</span></span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-x-8 text-sm text-[#B0B0B0]">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={link.key === current ? "text-white transition-colors" : "hover:text-white transition-colors"}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="mailto:wschenk@thefocus.ai"
        class="px-5 py-2 text-sm border border-white/20 text-[#E5E5E5] hover:bg-white/5 transition-colors"
      >
        Start a project
      </a>
    </div>

    <!-- Mobile menu trigger -->
    <button
      id="menuToggle"
      class="md:hidden w-9 h-9 flex items-center justify-center border border-white/15 hover:bg-white/5 transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="menu-icon-open"><Icon name="bars" /></span>
      <span class="menu-icon-close hidden"><Icon name="xmark" /></span>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobileMenu" class="md:hidden hidden border-t border-white/10">
    <div class="max-w-screen-xl mx-auto px-5 py-4 flex flex-col text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={
              link.key === current
                ? "py-2.5 text-white transition-colors"
                : "py-2.5 text-[#B0B0B0] hover:text-white transition-colors"
            }
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="mailto:wschenk@thefocus.ai"
        class="mt-3 w-full px-5 py-3 text-center text-sm border border-white/20 hover:bg-white/5 transition-colors"
      >
        Start a project
      </a>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");
  if (menuToggle && mobileMenu) {
    const setMenu = (open: boolean) => {
      mobileMenu.classList.toggle("hidden", !open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menuToggle.querySelector(".menu-icon-open")?.classList.toggle("hidden", open);
      menuToggle.querySelector(".menu-icon-close")?.classList.toggle("hidden", !open);
    };
    menuToggle.addEventListener("click", () => setMenu(mobileMenu.classList.contains("hidden")));
    mobileMenu.querySelectorAll("a").forEach((el) => el.addEventListener("click", () => setMenu(false)));
    window.matchMedia("(min-width: 768px)").addEventListener?.("change", (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
